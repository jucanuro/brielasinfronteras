# Copia este archivo a .env y completa los valores.
# Nunca subas el archivo .env real al repositorio.

# --- Django -----------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-generada-de-forma-segura
DJANGO_DEBUG=True
# Hosts separados por coma. En dev basta con localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origenes separados por coma, con esquema (https://). Requerido en produccion.
CSRF_TRUSTED_ORIGINS=

# --- Base de datos (Postgres) ------------------------------------------
# Usado por el contenedor db y por Django via DATABASE_URL.
POSTGRES_DB=brielasinfronteras
POSTGRES_USER=brielasinfronteras
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://brielasinfronteras:cambia-esta-clave@db:5432/brielasinfronteras

# --- Wagtail ------------------------------------------------------------
# URL base publica del sitio, usada para armar enlaces absolutos (emails, sitemap).
WAGTAILADMIN_BASE_URL=http://localhost:8000

# --- Correo -------------------------------------------------------------
# En dev, deja EMAIL_BACKEND en consola para ver los correos en los logs.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-responder@brielasinfronteras.org
# Correo unico configurable al que llegan los 3 formularios mientras no se
# definan buzones especificos por area (general/voluntariado/donaciones/empresas).
CONTACT_EMAIL=contacto@brielasinfronteras.org

# --- reCAPTCHA ------------------------------------------------------------
# Desactivado por defecto en dev. Poner en True y completar las llaves en produccion.
RECAPTCHA_ENABLED=False
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=

# --- Tailwind / Node ------------------------------------------------------
NODE_ENV=development
